CREATE OR REPLACE TABLE `rakamin-kf-analytics-511411.kimia_farma.kf_analisa` AS
WITH base AS (
  SELECT
    t.transaction_id,
    PARSE_DATE('%m/%d/%Y', t.date)        AS date,
    t.branch_id,
    c.branch_name,
    c.branch_category,
    c.kota,
    c.provinsi,
    c.rating                              AS rating_cabang,
    t.customer_name,
    t.product_id,
    p.product_name,
    p.product_category,
    p.price                               AS actual_price,
    t.discount_percentage,
    -- Persentase gross laba sesuai ketentuan harga
    CASE
      WHEN p.price <= 50000  THEN 0.10
      WHEN p.price <= 100000 THEN 0.15
      WHEN p.price <= 300000 THEN 0.20
      WHEN p.price <= 500000 THEN 0.25
      ELSE 0.30
    END                                   AS persentase_gross_laba,
    t.rating                              AS rating_transaksi
  FROM `rakamin-kf-analytics-511411.kimia_farma.kf_final_transaction` AS t
  LEFT JOIN `rakamin-kf-analytics-511411.kimia_farma.kf_product`       AS p ON t.product_id = p.product_id
  LEFT JOIN `rakamin-kf-analytics-511411.kimia_farma.kf_kantor_cabang` AS c ON t.branch_id  = c.branch_id
)
SELECT
  transaction_id, date, branch_id, branch_name, branch_category,
  CONCAT(CAST(branch_id AS STRING), ' - ', kota) AS branch_label,
  kota, provinsi, rating_cabang, customer_name, product_id, product_name,
  product_category, actual_price, discount_percentage, persentase_gross_laba,
  actual_price * (1 - discount_percentage)                         AS nett_sales,   -- harga setelah diskon
  actual_price * (1 - discount_percentage) * persentase_gross_laba AS nett_profit,  -- keuntungan Kimia Farma
  rating_transaksi
FROM base;
 
-- Validasi
SELECT COUNT(*) AS baris_analisa,
       COUNTIF(branch_name IS NULL OR product_name IS NULL OR date IS NULL) AS jumlah_null,
       MIN(date) AS tgl_awal, MAX(date) AS tgl_akhir,
       ROUND(SUM(nett_sales)) AS total_nett_sales, ROUND(SUM(nett_profit)) AS total_nett_profit
FROM `rakamin-kf-analytics-511411.kimia_farma.kf_analisa`;
 
